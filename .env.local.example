# Supabase Configuration (Free Tier)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Resend Email API Configuration (Free Tier)
RESEND_API_KEY=re_your_api_key_here
ALERT_SENDER_EMAIL=alerts@yourdomain.com

# Application URL (for 30-minute live viewer links in emails)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Security Secret for 30-Minute Live Streaming HMAC Tokens
TOKEN_SECRET=your-secure-random-secret-key
